node_modules/
.DS_Store
*.log
.env
content.bundle.js.map
cli-tools.bundle.js.map

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/
*.egg

# The `dist/` rule above is Python build output. The personalized extension
# writes JavaScript the service worker loads with importScripts into
# directories of the same name, and those outputs are committed like every
# other bundle in this repository. The directories have to be re-included
# first: git cannot un-ignore a file inside an ignored directory.
!personalized-extension/extension/browser-harness/dist/
!personalized-extension/extension/validation/dist/

.claude/worktrees/

# The analysis, copied in from the research repository by its install script.
# Mechanism lives here; the corpus text does not.
personalized-extension/extension/validation/corpus.json

# Client config for the personalized extension: the hosted toolkit service URL
# + a live access token. Per-checkout, never committed; build.js bakes it into
# the (also gitignored) generated remote-config.js the service worker reads.
personalized-extension/extension-config.local.json
personalized-extension/extension/lib/remote-config.js
